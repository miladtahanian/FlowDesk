# FlowDesk Docker Environment Configuration
# This file contains environment variables for Docker Compose development setup
# Copy to .env.docker if you want to override defaults

# Application Settings
APP_NAME=FlowDesk
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=dev-secret-key-change-in-production

# Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=flowdesk
MYSQL_USER=flowdesk
MYSQL_PASSWORD=password
DATABASE_URL=mysql+aiomysql://flowdesk:password@mysql:3306/flowdesk
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# MinIO/S3 Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=flowdesk
MINIO_SECURE=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000"]

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@flowdesk.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# JWT Token Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# FlowDesk Backend Environment Configuration
# Copy this file to .env and update the values

# Application
APP_NAME=FlowDesk
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# Security
SECRET_KEY=change-me-to-a-random-secret-key

# Database
DATABASE_URL=mysql+aiomysql://flowdesk:password@localhost:3306/flowdesk
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=flowdesk
MINIO_SECURE=false

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# JWT Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@flowdesk.com
